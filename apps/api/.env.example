# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bmad_starter_kit?schema=public"

# JWT
JWT_SECRET="your-secret-key-change-in-production"
JWT_ACCESS_TOKEN_EXPIRATION="15m"
JWT_REFRESH_TOKEN_EXPIRATION="7d"

# API
PORT=3000
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:8080"

# Anthropic Claude Agent SDK (用于 GitHub 项目信息抓取)
ANTHROPIC_AUTH_TOKEN="your-anthropic-auth-token-here"
# ANTHROPIC_BASE_URL="https://custom-api.anthropic.com"  # 可选：自定义 API 地址

GITHUB_TOKEN="your-github-token-here"